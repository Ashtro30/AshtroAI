# ───────────────────────────── Ashtro-AI configuration ─────────────────────────────
# Copy to .env and edit:   cp .env.example .env     (Windows: copy .env.example .env)

# ── LLM (LiteLLM model string) ────────────────────────────────────────────────────
# Local Ollama (default):   ollama_chat/llama3.1   |   ollama_chat/qwen2.5
LLM_MODEL=ollama_chat/llama3.1
# Ollama endpoint. Leave EMPTY for cloud providers.
LLM_API_BASE=http://localhost:11434

# Cloud examples (set LLM_API_BASE empty and the matching key below):
#   LLM_MODEL=openai/gpt-4o-mini
#   LLM_MODEL=anthropic/claude-sonnet-5-5
# Provider keys are read by LiteLLM from their standard variables:
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Generic override (passed straight to LiteLLM as api_key):
LLM_API_KEY=

LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2048
LLM_TIMEOUT=120
LLM_RETRIES=2
# Ask the provider for JSON output when supported (auto-retries without it if rejected)
LLM_JSON_MODE=true

# ── Agent loop ────────────────────────────────────────────────────────────────────
# Hard cap on reasoning steps per task (guard node stops the loop here)
AGENT_MAX_ITERATIONS=8
# Consecutive failed tool calls / malformed replies tolerated before giving up
AGENT_MAX_TOOL_RETRIES=3

# ── Memory & RAG ──────────────────────────────────────────────────────────────────
# sentence-transformers (semantic, downloads a small model on first run) or hash (offline, lexical)
EMBEDDING_BACKEND=sentence-transformers
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RAG_TOP_K=4
ENABLE_EPISODIC_MEMORY=true
MEMORY_MIN_SCORE=0.35
SHORT_TERM_TURNS=6

# ── Tools ─────────────────────────────────────────────────────────────────────────
# Wall-clock limit (seconds) for the sandboxed Python evaluator
PYTHON_TOOL_TIMEOUT=10

# ── Paths (relative paths resolve against the project root) ───────────────────────
# ASHTRO_DATA_DIR=data
# ASHTRO_OUTPUTS_DIR=outputs
# ASHTRO_STATE_DIR=.ashtro
